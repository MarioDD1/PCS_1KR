<Window x:Class="LibraryManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление библиотекой"
        Height="750"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        FontSize="14"
        Loaded="Window_Loaded"
        Background="#F3F6F9">

    <Window.Resources>
        <!-- Тёплая тёмная тема: глубокий графит и тёплый акцент -->
        <Color x:Key="PrimaryColor">#D97706</Color>
        <!-- тёплый оранжево-янтарный -->
        <Color x:Key="SuccessColor">#8FBF6B</Color>
        <Color x:Key="DangerColor">#E04E3D</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

        <!-- Фоны и текст -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1C1715"/>
        <SolidColorBrush x:Key="CardBrush" Color="#241E1C"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F6EFE8"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#CFC2B8"/>

        <!-- По умолчанию светлый текст для тёмной темы -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- Центрирование в ячейках -->
        <Style x:Key="CenterCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- Стиль для ячеек DataGrid -->
        <Style x:Key="DataGridCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <!-- Общий стиль для карточек -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderBrush" Value="#332621"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#22000000" BlurRadius="8" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Заголовки -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Входные элементы -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#2A2220"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#2A2220"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#2A2220"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#2A2220"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="RowBackground" Value="#221B19"/>
            <Setter Property="AlternatingRowBackground" Value="#1E1614"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="BorderBrush" Value="#1F1715"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- DataGridCell стиль для всех ячеек -->
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Управление библиотекой" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Style="{StaticResource CardStyle}" Padding="8,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Всего книг" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TotalBooksText" Text="0" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="8,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Авторов" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TotalAuthorsText" Text="0" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="8,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Жанров" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TotalGenresText" Text="0" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- Main content: left filters + right data -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left side: filters and operations -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Фильтрация" Style="{StaticResource HeaderStyle}"/>

                        <TextBlock Text="По названию" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" />

                        <TextBlock Text="Автор" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <ComboBox x:Name="AuthorFilterComboBox" DisplayMemberPath="FullName" SelectionChanged="Filter_Changed" Foreground="{StaticResource PrimaryBrush}"/>

                        <TextBlock Text="Жанр" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <ComboBox x:Name="GenreFilterComboBox" DisplayMemberPath="Name" SelectionChanged="Filter_Changed" Foreground="{StaticResource PrimaryBrush}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                            <Button Content="Сбросить" Click="ResetFilters_Click" Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Обновить" Click="Window_Loaded" Style="{StaticResource ActionButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Информация" Style="{StaticResource HeaderStyle}"/>
                        <TextBlock x:Name="SelectedBookInfo" Text="Книга не выбрана" Foreground="Gray" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Операции" Style="{StaticResource HeaderStyle}"/>
                        <UniformGrid Columns="3" HorizontalAlignment="Center" Margin="0,6,0,0" VerticalAlignment="Center">
                            <Button Content="Добавить" Click="AddBook_Click" Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Редактировать" Click="EditBook_Click" Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Удалить" Click="DeleteBook_Click" Style="{StaticResource DangerButtonStyle}"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Spacer -->
            <Grid Grid.Column="1" />

            <!-- Right side: DataGrid -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Список книг" Style="{StaticResource HeaderStyle}"/>
                        <DataGrid x:Name="BooksDataGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                  RowHeight="40" SelectionChanged="BooksDataGrid_SelectionChanged" MouseDoubleClick="BooksDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" ElementStyle="{StaticResource CenterCellStyle}"/>
                                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" ElementStyle="{StaticResource DataGridCellStyle}"/>
                                <DataGridTextColumn Header="Автор" Binding="{Binding Author.FullName}" Width="*" ElementStyle="{StaticResource DataGridCellStyle}"/>
                                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre.Name}" Width="140" ElementStyle="{StaticResource DataGridCellStyle}"/>
                                <DataGridTextColumn Header="Год" Binding="{Binding PublishYear}" Width="90" ElementStyle="{StaticResource CenterCellStyle}"/>
                                <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="140" ElementStyle="{StaticResource DataGridCellStyle}"/>
                                <DataGridTextColumn Header="В наличии" Binding="{Binding QuantityInStock}" Width="90" ElementStyle="{StaticResource CenterCellStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Footer: small help text -->
        <TextBlock Grid.Row="2" HorizontalAlignment="Right" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,8,4,0">Дважды щелкните строку для редактирования</TextBlock>
    </Grid>
</Window>