<Window x:Class="LibraryManagement.Views.AddEditBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление / Редактирование книги"
        Height="520"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">

    <Window.Resources>
        <!-- Новая спокойная палитра: мягкий индиго и глубокий графит -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#6B5B95"/>
        <SolidColorBrush x:Key="CardBrush" Color="#0B0F12"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8EDF6"/>

        <!-- Общие стили для тёмной темы -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#11232A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- Стиль ComboBox: фон темный, отображаемый (выбранный) текст — PrimaryBrush -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#11232A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <!-- Это влияет на отображаемый выбранный элемент и на текст в закрытом состоянии -->
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <!-- Применяем ItemContainerStyle по умолчанию к элементам выпадающего списка -->
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <!-- По умолчанию элементы имеют светлый цвет текста (контраст на тёмном фоне) -->
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="4,2"/>
                        <Style.Triggers>
                            <!-- При наведении подсвечиваем фон и делаем текст PrimaryBrush -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#1F2B33"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <!-- При выборе тоже используем PrimaryBrush для текста -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#243139"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryAction" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#5f4f86"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryAction" TargetType="Button" BasedOn="{StaticResource PrimaryAction}">
            <Setter Property="Background" Value="#263039"/>
            <Setter Property="BorderBrush" Value="#263039"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- Явный стиль для ComboBoxItem (если где-то понадобится отдельно) -->
        <Style x:Key="ComboBoxItemDefault" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- Ресурс эффекта тени, переиспользуемый -->
        <DropShadowEffect x:Key="DefaultDropShadow" Color="Black" Opacity="0.5" BlurRadius="8" ShadowDepth="0"/>
    </Window.Resources>

    <!-- Применяем DropShadowEffect напрямую, без привязки к типу SystemParameters -->
    <Border Margin="14" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" Effect="{StaticResource DefaultDropShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleTextBlock" Text="Добавление книги" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <UniformGrid Columns="1" Rows="6" VerticalAlignment="Top" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Название" FontWeight="SemiBold"/>
                        <TextBox x:Name="TitleTextBox"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Автор" FontWeight="SemiBold"/>
                        <!-- Если необходимо локально переопределить ItemContainerStyle, можно добавить: ItemContainerStyle="{StaticResource ComboBoxItemDefault}" -->
                        <ComboBox x:Name="AuthorComboBox" DisplayMemberPath="FullName"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Жанр" FontWeight="SemiBold"/>
                        <ComboBox x:Name="GenreComboBox" DisplayMemberPath="Name"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Год издания" FontWeight="SemiBold"/>
                        <TextBox x:Name="YearTextBox"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="ISBN" FontWeight="SemiBold"/>
                        <TextBox x:Name="ISBNTextBox"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Количество в наличии" FontWeight="SemiBold"/>
                        <TextBox x:Name="QuantityTextBox"/>
                    </StackPanel>
                </UniformGrid>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Сохранить" Click="SaveButton_Click" Style="{StaticResource PrimaryAction}"/>
                <Button Content="Отмена" Click="CancelButton_Click" Style="{StaticResource SecondaryAction}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>